# --- paths (relative paths resolve against the project root, not the cwd) ---
DATABASE_PATH=./data/app.db
OUTPUT_DIR=./output
LOG_DIR=./logs
BRAND_DIR=./brand
ASSET_CACHE_DIR=./data/assets

# --- worker ---
WORKER_POLL_INTERVAL_SECONDS=10

# --- Claude ---
# The default is a deliberate placeholder. With it, every agent call returns 401,
# each node falls back to its documented stub output, and the pipeline still
# produces a complete version — clearly marked STUB in the review UI.
# Put a real key here to generate for real; nothing else changes.
ANTHROPIC_API_KEY=sk-ant-dummy-key-not-a-real-key
ANTHROPIC_MODEL=claude-opus-5
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# --- media ---
VIDEO_ASPECT=vertical          # vertical | square | landscape
VIDEO_FPS=30
VIDEO_RENDER_THREADS=4
VOICEOVER_SAMPLE_RATE=44100
# Off by default: the voiceover is written as silence of the script's estimated
# spoken length, so video timing is correct and a real WAV can be dropped in.
# Set true (and `pip install pyttsx3`) to attempt offline Windows SAPI speech.
ENABLE_TTS=false
