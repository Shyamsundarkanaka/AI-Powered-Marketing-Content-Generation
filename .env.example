# Copy to .env and fill in the API key for whichever provider you select.
# Every value here is optional except the active provider's API key — the
# defaults shown are what the app uses when a line is absent.

# --- paths (relative paths resolve against the project root, not the cwd) ---
DATABASE_PATH=./data/app.db
OUTPUT_DIR=./output
LOG_DIR=./logs
BRAND_DIR=./brand
ASSET_CACHE_DIR=./data/assets

# --- logging ---
LOG_LEVEL=INFO                 # debug | info | warning | error
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# --- worker ---
WORKER_POLL_INTERVAL_SECONDS=5

# --- LLM -----------------------------------------------------------------
# REQUIRED. LLM_PROVIDER selects which block below is active; that provider's
# API key must be a real one. There is no offline or placeholder mode: if the
# model cannot be reached, the run fails and says so. Nothing is ever
# substituted locally, so no generated artifact is ever fake.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# GEMINI_BASE_URL=             # optional: custom API endpoint

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# OPENAI_BASE_URL=             # optional: Azure OpenAI / OpenAI-compatible proxy

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=          # optional: custom API endpoint

LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
# Transport retries (connection reset, 429, 5xx) — handled by the provider client.
LLM_MAX_RETRIES=3
# Shape retries: how many times a node may re-ask after the model returned
# something that didn't parse or didn't match the schema. The retry includes
# the specific error, so most misses self-correct on the second attempt.
LLM_JSON_ATTEMPTS=3

# --- media ---------------------------------------------------------------
VIDEO_ASPECT=vertical          # vertical | square | landscape
VIDEO_FPS=30
VIDEO_RENDER_THREADS=4
VOICEOVER_SAMPLE_RATE=44100

# Ordered TTS engine chain; the first one that works wins. Leave empty to skip
# synthesis and always write a silent track (the video still times correctly,
# and the review UI flags it clearly). Adding a paid engine is one function in
# media/voice.py — see the module docstring for a worked example.
#   piper   — local/offline neural TTS, no API key, needs PIPER_MODEL_PATH
#   pyttsx3 — whatever voices the OS already has; quality varies
TTS_ENGINES=piper,pyttsx3
# Path to a downloaded Piper voice .onnx file, with its .onnx.json sidecar
# next to it. Voices: https://github.com/rhasspy/piper/blob/master/VOICES.md
PIPER_MODEL_PATH=./data/voices/en_US-lessac-medium.onnx

# --- scraping ---
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
